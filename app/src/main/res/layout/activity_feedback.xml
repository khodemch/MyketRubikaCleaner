    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/_16sdp"
        android:fontFamily="@font/yekan"
        android:background="#F7FFF7"
        tools:context=".MainActivity">

        <TextView
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="کاربر عزیز!"
            android:fontFamily="@font/yekan"
            android:textColor="#1A535C"
            android:textSize="@dimen/_16ssp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPositiveFeedback"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:backgroundTint="#1A535C"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="بله"
            android:fontFamily="@font/yekan"
            android:textColor="#F7FFF7"
            android:textSize="@dimen/_14ssp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView8" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnNegativeFeedback"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:backgroundTint="#1A535C"
            android:text="خیر"
            android:textColor="#F7FFF7"
            android:textSize="@dimen/_14ssp"
            android:textStyle="bold"
            android:fontFamily="@font/yekan"
            android:layout_marginTop="@dimen/_8sdp"
            app:layout_constraintEnd_toEndOf="@+id/btnPositiveFeedback"
            app:layout_constraintStart_toStartOf="@+id/btnPositiveFeedback"
            app:layout_constraintTop_toBottomOf="@+id/btnPositiveFeedback" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/negativeFeedbackContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible"
            android:fontFamily="@font/yekan"
            app:layout_constraintEnd_toEndOf="@+id/btnNegativeFeedback"
            app:layout_constraintStart_toStartOf="@+id/btnNegativeFeedback"
            app:layout_constraintTop_toBottomOf="@+id/btnNegativeFeedback">

        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_100sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:fontFamily="@font/yekan"
            app:layout_constraintTop_toBottomOf="@+id/btnSubmitNegativeFeedback"
            android:src="@drawable/logoapp" />

        <EditText
            android:id="@+id/editTextNegativeFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="7"
            android:textAlignment="center"
            android:hint="نظر خود را اینجا وارد کنید"
            android:textColor="#F7FFF7"
            android:textColorHint="#F7FFF7"
            android:fontFamily="@font/yekan"
            android:visibility="gone"
            android:textSize="@dimen/_16ssp"
            android:layout_marginTop="@dimen/_20sdp"
            android:background="@drawable/feedback_edit_text_background"
            app:layout_constraintEnd_toEndOf="@+id/btnNegativeFeedback"
            app:layout_constraintStart_toStartOf="@+id/btnNegativeFeedback"
            app:layout_constraintTop_toBottomOf="@+id/negativeFeedbackContainer" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSubmitNegativeFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/yekan"
            android:backgroundTint="#1A535C"
            android:text="ارسال نظر"
            android:textColor="#F7FFF7"
            android:textSize="@dimen/_14ssp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginTop="@dimen/_8sdp"
            app:layout_constraintEnd_toEndOf="@+id/editTextNegativeFeedback"
            app:layout_constraintStart_toStartOf="@+id/editTextNegativeFeedback"
            app:layout_constraintTop_toBottomOf="@+id/editTextNegativeFeedback" />

        <TextView
            android:id="@+id/textView7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="روبیکا کلینر"
            android:textColor="#1A535C"
            android:textSize="@dimen/_16ssp"
            android:fontFamily="@font/yekan"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/_8sdp"
            app:layout_constraintEnd_toEndOf="@+id/imageView2"
            app:layout_constraintStart_toStartOf="@+id/imageView2"
            app:layout_constraintTop_toBottomOf="@+id/imageView2" />

        <TextView
            android:id="@+id/textView6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="مدیریت فایل های روبیکا"
            android:textColor="#1A535C"
            android:fontFamily="@font/yekan"
            android:textSize="@dimen/_16ssp"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/_4sdp"
            app:layout_constraintEnd_toEndOf="@+id/textView7"
            app:layout_constraintStart_toStartOf="@+id/textView7"
            app:layout_constraintTop_toBottomOf="@+id/textView7" />

        <TextView
            android:id="@+id/textView8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="آیا از برنامه راضی هستید؟"
            android:textColor="#1A535C"
            android:textSize="@dimen/_16ssp"
            android:fontFamily="@font/yekan"
            app:layout_constraintEnd_toEndOf="@+id/textView3"
            app:layout_constraintStart_toStartOf="@+id/textView3"
            app:layout_constraintTop_toBottomOf="@+id/textView3" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>